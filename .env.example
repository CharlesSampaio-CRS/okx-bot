# OKX API (conta live). Permissões: Trade + Read. Sem withdraw.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 0 = live, 1 = demo/simulated trading da OKX
OKX_FLAG=0

OKX_BASE_URL=https://www.okx.com

# MongoDB Atlas — também usa a collection api_cache (caçador, histórico, candles)
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/okbot?appName=ClusterDbMongoAtlas

# Login Google (mesmo Cognito do QuitoPay)
COGNITO_REGION=sa-east-1
COGNITO_USER_POOL_ID=sa-east-1_Kq7p6kjES
COGNITO_CLIENT_ID=7qnmua2ps91lt2gp8km4s8g10s
COGNITO_DOMAIN=quittopay-00064.auth.sa-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://127.0.0.1:8080/api/auth/callback

# Copiloto: Cursor (padrão). Sem chave, entende frases simples em português.
LLM_PROVIDER=cursor
