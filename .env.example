# OKX API (conta live). Permissões: Trade + Read. Sem withdraw.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 0 = live, 1 = demo/simulated trading da OKX
OKX_FLAG=0

OKX_BASE_URL=https://www.okx.com

# MongoDB Atlas — também usa a collection api_cache (caçador, histórico, candles)
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/okbot?appName=ClusterDbMongoAtlas

# Login Google (OAuth direto — sem Cognito)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/auth/callback

# Copiloto: Cursor (padrão). Sem chave, entende frases simples em português.
LLM_PROVIDER=cursor
# Dashboard Cursor → Integrations → API key
# CURSOR_API_KEY=
# CURSOR_MODEL=
# Alternativa OpenAI-compatível:
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
